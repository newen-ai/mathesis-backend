// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  MEMBER
  ADMIN
}

enum WhitelistRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MensaBadgeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedPostReactionValue {
  value
}

enum ContactMessageCategory {
  GENERAL_INQUIRY
  TECHNICAL_ISSUE
  SUGGESTION
  BUG_REPORT
  OTHER
}

enum AteneoTopicTone {
  LIBRE
  SERIO
  RECOMENDADO
}

enum AteneoPermissionMode {
  free
  admins
}

enum AteneoReactionValue {
  value
}

enum UserBlockAuditAction {
  BLOCK
  UNBLOCK
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  canonicalEmail String @map("canonical_email")
  passwordHash String  @map("password_hash")
  role      String    @default("user")
  emailVerifiedAt DateTime? @map("email_verified_at")
  emailVerificationToken String? @unique @map("email_verification_token")
  passwordResetToken String? @unique @map("password_reset_token")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")
  authSessionVersion Int @default(1) @map("auth_session_version")
  themePreference String? @default("light") @map("theme_preference")
  mensaEmpresariosAdminAt DateTime? @map("mensa_empresarios_admin_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile              Profile?
  connectionsAsUserA   Connection[] @relation("UserConnectionsA")
  connectionsAsUserB   Connection[] @relation("UserConnectionsB")
  chatMemberships      ChatMember[]
  createdChats         Chat[]       @relation("ChatCreatedBy")
  sentChatMessages     ChatMessage[] @relation("ChatMessageSender")
  deletedChatMessages  ChatMessage[] @relation("ChatMessageDeletedBy")
  feedPosts            FeedPost[]   @relation("FeedPostAuthor")
  feedPostReactions    FeedPostReaction[] @relation("FeedPostReactionUser")
  whitelistRequests    WhitelistRequest[] @relation("WhitelistRequestUser")
  reviewedWhitelistRequests WhitelistRequest[] @relation("WhitelistRequestReviewer")
  whitelistAuditsAsActor WhitelistAudit[] @relation("WhitelistAuditActor")
  whitelistAuditsAsTarget WhitelistAudit[] @relation("WhitelistAuditTarget")
  whitelistedEmailsCreated WhitelistedEmail[] @relation("WhitelistedEmailCreator")
  contactMessages      ContactMessage[] @relation("ContactMessageUser")
  badges               UserBadge[]
  enterprises          Enterprise[]
  mensaBadgeRequests          MensaBadgeRequest[] @relation("MensaBadgeRequestUser")
  reviewedMensaBadgeRequests  MensaBadgeRequest[] @relation("MensaBadgeRequestReviewer")
  ateneoGroupMemberships      AteneoGroupMember[]
  ateneoGroupsCreated         AteneoGroup[]       @relation("AteneoGroupCreatedBy")
  ateneoTopicsAuthored        AteneoTopic[]       @relation("AteneoTopicAuthor")
  ateneoTopicCommentsAuthored AteneoTopicComment[] @relation("AteneoTopicCommentAuthor")
  ateneoTopicCommentsMentioned AteneoTopicComment[] @relation("AteneoTopicCommentMentionUser")
  ateneoTopicReactions        AteneoTopicReaction[]
  ateneoTopicCommentReactions AteneoTopicCommentReaction[]
  blocksInitiated             UserBlock[] @relation("UserBlocksInitiated")
  blocksReceived              UserBlock[] @relation("UserBlocksReceived")
  blockAuditsAsActor          UserBlockAudit[] @relation("UserBlockAuditActor")
  blockAuditsAsTarget         UserBlockAudit[] @relation("UserBlockAuditTarget")

  @@index([deletedAt])
  @@index([canonicalEmail])
  @@map("users")
}

model AteneoGroup {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  description       String?
  createTopicsMode  AteneoPermissionMode @default(free) @map("create_topics_mode")
  commentsMode      AteneoPermissionMode @default(free) @map("comments_mode")
  memberSubtitle    String    @default("0 miembros") @map("member_subtitle")
  activityLabel     String    @default("Sin actividad") @map("activity_label")
  icon              String    @default("community")
  isOfficial        Boolean   @default(false) @map("is_official")
  createdByUserId   String    @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  createdBy         User              @relation("AteneoGroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  rules             AteneoGroupRule[]
  memberships       AteneoGroupMember[]
  topics            AteneoTopic[]

  @@index([deletedAt])
  @@index([createdByUserId, deletedAt])
  @@map("ateneo_groups")
}

model AteneoGroupRule {
  id          String    @id @default(cuid())
  groupId     String    @map("group_id")
  text        String
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  group       AteneoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, deletedAt, position])
  @@map("ateneo_group_rules")
}

model AteneoGroupMember {
  id          String    @id @default(cuid())
  groupId     String    @map("group_id")
  userId      String    @map("user_id")
  isAdmin     Boolean   @default(false) @map("is_admin")
  isPinned    Boolean   @default(false) @map("is_pinned")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  leftAt      DateTime? @map("left_at")
  deletedAt   DateTime? @map("deleted_at")

  group       AteneoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, deletedAt, leftAt])
  @@index([userId, deletedAt, leftAt])
  @@index([isPinned, userId, deletedAt])
  @@map("ateneo_group_members")
}

model AteneoTopic {
  id              String          @id @default(cuid())
  groupId         String          @map("group_id")
  authorUserId    String          @map("author_user_id")
  title           String
  description     String
  tone            AteneoTopicTone @default(LIBRE)
  reactionCount   Int             @default(0) @map("reaction_count")
  commentCount    Int             @default(0) @map("comment_count")
  isRecommended   Boolean         @default(false) @map("is_recommended")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  group           AteneoGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author          User                    @relation("AteneoTopicAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  comments        AteneoTopicComment[]
  reactions       AteneoTopicReaction[]

  @@index([groupId, deletedAt, createdAt(sort: Desc)])
  @@index([authorUserId, deletedAt])
  @@index([isRecommended, deletedAt, createdAt(sort: Desc)])
  @@map("ateneo_topics")
}

model AteneoTopicComment {
  id                  String    @id @default(cuid())
  topicId             String    @map("topic_id")
  authorUserId        String    @map("author_user_id")
  content             String
  parentCommentId     String?   @map("parent_comment_id")
  mentionUserId       String?   @map("mention_user_id")
  reactionCount       Int       @default(0) @map("reaction_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  topic               AteneoTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author              User                 @relation("AteneoTopicCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  parentComment       AteneoTopicComment?  @relation("AteneoCommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies             AteneoTopicComment[] @relation("AteneoCommentReplies")
  mentionUser         User?                @relation("AteneoTopicCommentMentionUser", fields: [mentionUserId], references: [id], onDelete: SetNull)
  reactions           AteneoTopicCommentReaction[]

  @@index([topicId, deletedAt, createdAt(sort: Asc)])
  @@index([authorUserId, deletedAt])
  @@index([parentCommentId, deletedAt])
  @@map("ateneo_topic_comments")
}

model AteneoTopicReaction {
  id              String              @id @default(cuid())
  topicId         String              @map("topic_id")
  userId          String              @map("user_id")
  reactionValue   AteneoReactionValue @map("reaction_value")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  topic           AteneoTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([topicId])
  @@index([userId])
  @@map("ateneo_topic_reactions")
}

model AteneoTopicCommentReaction {
  id              String              @id @default(cuid())
  commentId       String              @map("comment_id")
  userId          String              @map("user_id")
  reactionValue   AteneoReactionValue @map("reaction_value")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  comment         AteneoTopicComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("ateneo_topic_comment_reactions")
}

model WhitelistedEmail {
  id             String   @id @default(cuid())
  canonicalEmail String   @unique @map("canonical_email")
  createdByUserId String? @map("created_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdByUser  User?    @relation("WhitelistedEmailCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("whitelisted_emails")
}

model WhitelistRequest {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  canonicalEmail  String               @map("canonical_email")
  message         String?
  status          WhitelistRequestStatus @default(PENDING)
  reviewedByUserId String?             @map("reviewed_by_user_id")
  reviewedAt      DateTime?            @map("reviewed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user            User                 @relation("WhitelistRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser  User?                @relation("WhitelistRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([canonicalEmail, status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("whitelist_requests")
}

model WhitelistAudit {
  id              String   @id @default(cuid())
  action          String
  canonicalEmail  String   @map("canonical_email")
  targetUserId    String?  @map("target_user_id")
  actorUserId     String?  @map("actor_user_id")
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  targetUser      User?    @relation("WhitelistAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  actorUser       User?    @relation("WhitelistAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt(sort: Desc)])
  @@index([canonicalEmail, createdAt(sort: Desc)])
  @@map("whitelist_audit")
}

model FeedPost {
  id          String           @id @default(cuid())
  authorUserId String           @map("author_user_id")
  content     String?
  reactionCount Int             @default(0) @map("reaction_count")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  author      User             @relation("FeedPostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  attachments FeedAttachment[]
  reactions   FeedPostReaction[]

  @@index([deletedAt])
  @@index([authorUserId, deletedAt])
  @@index([createdAt(sort: Desc), deletedAt])
  @@map("feed_posts")
}

model FeedPostReaction {
  id           String                @id @default(cuid())
  feedPostId   String                @map("feed_post_id")
  userId       String                @map("user_id")
  reactionValue FeedPostReactionValue @map("reaction_value")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  feedPost     FeedPost              @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  user         User                  @relation("FeedPostReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedPostId, userId])
  @@index([feedPostId])
  @@index([userId])
  @@map("feed_post_reactions")
}

model FeedAttachment {
  id          String    @id @default(cuid())
  feedPostId  String    @map("feed_post_id")
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  fileData    Bytes     @map("file_data")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  feedPost    FeedPost  @relation(fields: [feedPostId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([feedPostId, deletedAt])
  @@map("feed_attachments")
}

model Chat {
  id              String      @id @default(cuid())
  type            ChatType
  title           String?
  createdByUserId String      @map("created_by_user_id")
  directUserLowId  String?     @map("direct_user_low_id")
  directUserHighId String?     @map("direct_user_high_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  createdBy       User        @relation("ChatCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members         ChatMember[]
  messages        ChatMessage[]

  @@index([deletedAt])
  @@index([type, deletedAt])
  @@index([createdByUserId, deletedAt])
  @@index([directUserLowId, directUserHighId, deletedAt])
  @@map("chats")
}

model ChatMember {
  id        String         @id @default(cuid())
  chatId    String         @map("chat_id")
  userId    String         @map("user_id")
  role      ChatMemberRole @default(MEMBER)
  lastReadMessageAt DateTime? @map("last_read_message_at")
  joinedAt  DateTime       @default(now()) @map("joined_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  leftAt    DateTime?      @map("left_at")
  deletedAt DateTime?      @map("deleted_at")

  chat      Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([deletedAt])
  @@index([chatId, leftAt, deletedAt])
  @@index([userId, leftAt, deletedAt])
  @@index([chatId, userId, lastReadMessageAt])
  @@map("chat_members")
}

model ChatMessage {
  id              String    @id @default(cuid())
  chatId          String    @map("chat_id")
  senderUserId    String    @map("sender_user_id")
  content         String
  editedAt        DateTime? @map("edited_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id")

  chat            Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender          User      @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  deletedBy       User?     @relation("ChatMessageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([chatId, deletedAt, createdAt(sort: Desc)])
  @@index([senderUserId, deletedAt])
  @@map("chat_messages")
}

model Connection {
  id        String    @id @default(cuid())
  userAId   String    @map("user_a_id")
  userBId   String    @map("user_b_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userA     User      @relation("UserConnectionsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("UserConnectionsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([userAId, deletedAt])
  @@index([userBId, deletedAt])
  @@index([userAId, userBId, deletedAt])
  @@map("connections")
}

model UserBlock {
  id            String    @id @default(cuid())
  blockerUserId String    @map("blocker_user_id")
  blockedUserId String    @map("blocked_user_id")
  reasonNote    String?   @map("reason_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  liftedAt      DateTime? @map("lifted_at")

  blocker       User      @relation("UserBlocksInitiated", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked       User      @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId, liftedAt])
  @@index([blockedUserId, liftedAt])
  @@index([blockerUserId, blockedUserId, liftedAt])
  @@map("user_blocks")
}

model UserBlockAudit {
  id            String               @id @default(cuid())
  action        UserBlockAuditAction
  actorUserId   String?              @map("actor_user_id")
  targetUserId  String?              @map("target_user_id")
  reasonNote    String?              @map("reason_note")
  occurredAt    DateTime             @default(now()) @map("occurred_at")

  actor         User?                @relation("UserBlockAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target        User?                @relation("UserBlockAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([action, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([targetUserId, occurredAt(sort: Desc)])
  @@map("user_block_audit")
}

model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  dateOfBirth      DateTime? @map("date_of_birth")
  nationality      String?
  currentJobTitle  String?   @map("current_job_title")
  currentCompany   String?   @map("current_company")
  about            String?
  locationCountry  String?   @map("location_country")
  locationCity     String?   @map("location_city")
  locationPostalCode String? @map("location_postal_code")
  interests        String[]  @default([])
  profileImageUrl  String?   @map("profile_image_url")
  profileBannerImageUrl String? @map("profile_banner_image_url")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences   WorkExperience[]
  educationExperiences EducationExperience[]

  @@index([deletedAt])
  @@map("profiles")
}

model WorkExperience {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id")
  company   String
  jobTitle  String    @map("job_title")
  description String?
  startDate String    @map("start_date") // Format: "YYYY-MM"
  endDate   String?   @map("end_date") // Format: "YYYY-MM", nullable if still working
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([profileId, deletedAt, startDate(sort: Desc)])
  @@map("work_experiences")
}

model EducationExperience {
  id           String    @id @default(cuid())
  profileId    String    @map("profile_id")
  institution  String
  degree       String
  fieldOfStudy String?   @map("field_of_study")
  startDate    String    @map("start_date") // Format: "YYYY-MM"
  endDate      String?   @map("end_date") // Format: "YYYY-MM", nullable if still studying
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([profileId, deletedAt, startDate(sort: Desc)])
  @@map("education_experiences")
}

model ContactMessage {
  id        String                   @id @default(cuid())
  userId    String                   @map("user_id")
  category  ContactMessageCategory
  details   String
  createdAt DateTime                 @default(now()) @map("created_at")

  user      User                     @relation("ContactMessageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@map("contact_messages")
}

model UserBadge {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  badgeSlug  String    @map("badge_slug")
  grantedAt  DateTime  @default(now()) @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, badgeSlug])
  @@map("user_badges")
}

model MensaBadgeRequest {
  id               String                   @id @default(cuid())
  userId           String                   @map("user_id")
  badgeSlug        String                   @map("badge_slug")
  message          String?
  status           MensaBadgeRequestStatus  @default(PENDING)
  reviewedByUserId String?                  @map("reviewed_by_user_id")
  reviewedAt       DateTime?                @map("reviewed_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  user             User  @relation("MensaBadgeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User? @relation("MensaBadgeRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([badgeSlug, status, createdAt(sort: Desc)])
  @@index([userId, badgeSlug])
  @@map("mensa_badge_requests")
}

model Enterprise {
  id            String           @id @default(cuid())
  ownerUserId   String           @map("owner_user_id")
  name          String
  role          String
  website       String?
  description   String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  owner         User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([ownerUserId, deletedAt, createdAt(sort: Desc)])
  @@map("enterprises")
}
