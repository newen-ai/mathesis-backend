DATABASE_URL="postgresql://user:password@localhost:5432/mensa_linkedin"
NODE_ENV=dev
PORT=4000
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_ISSUER=mensa-linkedin-backend
JWT_AUDIENCE=mensa-linkedin-web
# Use the browser origin only; path segments are ignored.
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated CORS allowlist for multiple frontend origins.
# Example: FRONTEND_ORIGINS=http://localhost:3000,https://test.mathesis.social
FRONTEND_ORIGINS=
AUTH_COOKIE_NAME=ml_access_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
